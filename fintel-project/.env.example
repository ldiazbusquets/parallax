# Copy to .env (git-ignored). Everything is optional: the terminal runs without any keys.

# SEC asks automated tools to identify themselves with a contact email, e.g. "Your Name you@example.com".
# Without it EDGAR may refuse requests (the SEC filings panel would show "unavailable").
SEC_USER_AGENT=

# Optional keys (you can also paste them in Settings inside the app; those stay in your browser).
VITE_FINNHUB_KEY=
VITE_GROQ_KEY=

